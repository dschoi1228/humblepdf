{
  "name": "humblepdf",
  "description": "A humble little PDF tool: merge, sign, mark up. Fully offline.",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exe": "tauri build --no-bundle",
    "build:installer": "tauri build --bundles nsis",
    "bindings": "node scripts/run-with-env.mjs UPDATE_BINDINGS=1 -- cargo test -p humblepdf-core --test bindings",
    "fixtures": "cargo run -q -p humblepdf-core --example gen_fixtures --release -- --large",
    "sample": "node scripts/sample.mjs",
    "fonts": "node scripts/fonts.mjs",
    "icons": "node scripts/icons.mjs",
    "notices": "node scripts/notices.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && tsc -b --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
